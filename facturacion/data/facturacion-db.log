create table Autor (oid varchar(32) not null, nombre varchar(50), primary key (oid))
create table Categoria (oid varchar(32) not null, descripcion varchar(50), primary key (oid))
create table Cliente (numero integer not null, codigoPostal integer, municipio varchar(20), provincia varchar(30), viaPublica varchar(30), nombre varchar(50), primary key (numero))
create table DocumentoComercial (DTYPE varchar(31) not null, oid varchar(32) not null, eliminado BOOLEAN DEFAULT FALSE, anyo integer, fecha date, importeTotal numeric(19,2), iva numeric(19,2), numero integer, observaciones varchar(255), porcentajeIVA numeric(2,0), diasEntrega INTEGER DEFAULT 1, entregado BOOLEAN DEFAULT FALSE, cliente_numero integer not null, factura_oid varchar(32), primary key (oid))
create table DocumentoComercial_detalles (DocumentoComercial_oid varchar(32) not null, cantidad integer not null, precioPorUnidad numeric(19,2), producto_numero integer)
create table IMAGES (ID varchar(32) not null, GALLERY varchar(32), image varbinary(16777216), primary key (ID))
create table OXDISCUSSIONCOMMENTS (id varchar(32) not null, comment clob(16777216), discussionId varchar(32), time timestamp, userName varchar(30), primary key (id))
create table Producto (numero integer not null, descripcion varchar(50), fotos varchar(32), isbn varchar(13), observaciones varchar(255), precio numeric(19,2), autor_oid varchar(32), categoria_oid varchar(32), primary key (numero))
create index IDXbhlx4vunn24ym1tbrlgq8g30m on OXDISCUSSIONCOMMENTS (discussionId)
alter table DocumentoComercial add constraint FKqxvhhtdl5x1bljcimyej4mksx foreign key (cliente_numero) references Cliente
alter table DocumentoComercial add constraint FK4lhtu14i3f0y8m4ohuxww2b48 foreign key (factura_oid) references DocumentoComercial
alter table DocumentoComercial_detalles add constraint FKgyn78bk9nimdbk5uxm7ioiib1 foreign key (producto_numero) references Producto
alter table DocumentoComercial_detalles add constraint FKq37xaecvr7po697tmegcffoba foreign key (DocumentoComercial_oid) references DocumentoComercial
alter table Producto add constraint FKmtkejrnklbkimttu99b9jqufw foreign key (autor_oid) references Autor
alter table Producto add constraint FKc81rcy0vfdn5ewnap5scabhd3 foreign key (categoria_oid) references Categoria
